page{background:#f7fbf8;color:#17352a;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif}.page{padding:28rpx}.hero{background:linear-gradient(135deg,#126642,#35ad75);color:#fff;border-radius:0 0 40rpx 40rpx;padding:38rpx 30rpx;margin:-28rpx -28rpx 28rpx}.title{font-size:38rpx;font-weight:800}.sub{font-size:24rpx;opacity:.84;margin-top:12rpx}.card{background:#fff;border-radius:28rpx;padding:28rpx;margin-bottom:22rpx;box-shadow:0 10rpx 32rpx rgba(23,53,42,.06)}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.action{background:#e9f7ef;color:#167c53;border-radius:20rpx;padding:28rpx 12rpx;text-align:center;font-weight:700}.action.primary{background:#167c53;color:#fff}.label{font-size:24rpx;color:#6b7c74;margin-bottom:10rpx}.input{border:1rpx solid #dcebe1;border-radius:16rpx;padding:20rpx;margin-bottom:18rpx;background:#fbfefc}.button{background:#167c53!important;color:#fff!important;border-radius:18rpx!important;font-weight:700}.button.secondary{background:#e9f7ef!important;color:#167c53!important}.record{display:flex;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #edf4ef}.thumb{width:130rpx;height:130rpx;border-radius:18rpx;background:#edf6ef}.grow{flex:1}.name{font-weight:800;font-size:30rpx}.muted{color:#6b7c74;font-size:23rpx;margin-top:8rpx}.tag{display:inline-block;padding:8rpx 14rpx;border-radius:999rpx;background:#e9f7ef;color:#167c53;font-size:21rpx;margin-top:10rpx}.result-image{width:100%;height:430rpx;border-radius:22rpx;background:#edf6ef}.row{display:flex;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid #edf4ef}.empty{text-align:center;color:#6b7c74;padding:50rpx 0}