page{background:#f7fbf8;color:#17352a;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif}.page{padding:28rpx;overflow-x:hidden}.hero{background:linear-gradient(135deg,#126642,#35ad75);color:#fff;border-radius:0 0 40rpx 40rpx;padding:38rpx 30rpx;margin:-28rpx -28rpx 28rpx}.title{font-size:38rpx;font-weight:800}.sub{font-size:24rpx;opacity:.84;margin-top:12rpx}.card{background:#fff;border-radius:28rpx;padding:28rpx;margin-bottom:22rpx;box-shadow:0 10rpx 32rpx rgba(23,53,42,.06)}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.action{background:#e9f7ef;color:#167c53;border-radius:20rpx;padding:28rpx 12rpx;text-align:center;font-weight:700}.action.primary{background:#167c53;color:#fff}.label{font-size:24rpx;color:#6b7c74;margin-bottom:10rpx}.input{border:1rpx solid #dcebe1;border-radius:16rpx;padding:20rpx;margin-bottom:18rpx;background:#fbfefc}.button{width:100%;box-sizing:border-box;background:#167c53!important;color:#fff!important;border-radius:18rpx!important;font-weight:700}.button.secondary{background:#e9f7ef!important;color:#167c53!important}.record{display:flex;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #edf4ef}.thumb{width:130rpx;height:130rpx;border-radius:18rpx;background:#edf6ef}.grow{flex:1;min-width:0}.name{font-weight:800;font-size:30rpx}.muted{color:#6b7c74;font-size:23rpx;margin-top:8rpx}.tag{display:inline-block;padding:8rpx 14rpx;border-radius:999rpx;background:#e9f7ef;color:#167c53;font-size:21rpx;margin-top:10rpx}.result-image{width:100%;height:430rpx;border-radius:22rpx;background:#edf6ef}.row{display:flex;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid #edf4ef}.empty{text-align:center;color:#6b7c74;padding:50rpx 0}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-top:28rpx}.stat{min-width:0;padding:18rpx 8rpx;border:1rpx solid rgba(255,255,255,.26);border-radius:14rpx;background:rgba(255,255,255,.12);font-size:21rpx;text-align:center}.stat-number{font-size:42rpx;font-weight:800;line-height:1.15;margin-bottom:5rpx}.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx}.section-head .name{margin:0}.help{display:grid;place-items:center;width:36rpx;height:36rpx;border:1rpx solid #dcebe1;border-radius:50%;color:#167c53;font-weight:800}.quick-card{padding-bottom:12rpx}.quick-row{padding:18rpx 0;border-top:1rpx solid #edf4ef;color:#4b6257;font-size:24rpx;line-height:1.65}.guide-mask{position:fixed;inset:0;z-index:99;display:flex;align-items:center;justify-content:center;padding:28rpx;box-sizing:border-box;background:rgba(15,44,32,.58);overflow-y:auto}.guide,.help-dialog{position:relative;width:100%;max-width:620rpx;max-height:calc(100vh - 56rpx);box-sizing:border-box;overflow-y:auto;border-radius:20rpx;background:#fff;padding:36rpx 30rpx}.guide-kicker{font-size:22rpx;color:#167c53;font-weight:700}.guide-title{font-size:36rpx;font-weight:800;line-height:1.25;margin:10rpx 0 26rpx;word-break:break-all}.guide-step{display:grid;grid-template-columns:42rpx minmax(0,1fr);gap:16rpx;margin-top:22rpx;color:#17352a;font-size:27rpx;line-height:1.5}.guide-step text{display:grid;place-items:center;width:42rpx;height:42rpx;border-radius:50%;background:#167c53;color:#fff;font-size:23rpx;font-weight:700}.guide-step view view:last-child{font-size:22rpx;color:#6b7c74;margin-top:4rpx;word-break:break-all}.guide-actions{display:flex;gap:16rpx;margin-top:34rpx;width:100%}.guide-actions .button{flex:1 1 0;width:0;min-width:0;margin:0;padding-left:8rpx;padding-right:8rpx;white-space:nowrap}.help-close{position:absolute;right:24rpx;top:18rpx;width:44rpx;height:44rpx;text-align:center;line-height:40rpx;border-radius:50%;background:#e9f7ef;color:#167c53;font-size:38rpx}.help-text{font-size:26rpx;color:#6b7c74;line-height:1.8;word-break:break-all}
