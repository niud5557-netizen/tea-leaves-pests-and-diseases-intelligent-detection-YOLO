<view class="page">
  <view class="card">
    <view class="label">巡查地块</view>
    <picker disabled="{{!fields.length}}" range="{{fields}}" range-key="name" value="{{fieldIndex}}" bindchange="fieldChange"><view class="input">{{fieldName || (fieldsLoading ? '正在加载地块...' : '请选择地块')}}</view></picker>
    <view wx:if="{{fieldError}}" class="field-error">{{fieldError}}</view>
    <button class="button secondary" bindtap="choose">拍照或选择图片</button>
    <button class="button secondary" bindtap="openCamera">打开相机快照</button>
    <view wx:if="{{cameraVisible}}" class="camera-panel">
      <camera device-position="back" flash="off" class="camera-view"></camera>
      <view class="camera-hint">相机快照模式，每次采样间隔至少1.5秒</view>
      <view class="grid"><button class="button" loading="{{cameraBusy}}" bindtap="takeCameraPhoto">采集当前画面</button><button class="button secondary" bindtap="closeCamera">关闭相机</button></view>
    </view>
    <image wx:if="{{image}}" class="result-image" src="{{image}}" mode="aspectFit" />
    <button class="button" loading="{{uploading}}" bindtap="predict" style="margin-top:20rpx">开始识别</button>
  </view>

  <view class="card" wx:if="{{result}}">
    <view class="name">{{result.diseaseName}}</view>
    <view class="row"><text>模型把握度</text><text>{{confidenceText}}</text></view>
    <view class="row"><text>初筛状态</text><text>{{screeningText}}</text></view>
    <view class="row"><text>图像质量</text><text>{{result.result.quality.score}}分</text></view>
    <view class="muted">{{result.advice}}</view>

    <view class="knowledge-panel" wx:if="{{knowledge.length}}">
      <view class="knowledge-title">治理建议</view>
      <view class="knowledge-card" wx:for="{{knowledge}}" wx:key="name">
        <view class="knowledge-head"><view class="knowledge-name">{{item.name}}</view><view class="tag">{{item.categoryText}} · {{item.confidence}}</view></view>
        <view class="knowledge-section"><text>症状描述</text><view>{{item.symptoms}}</view></view>
        <view class="knowledge-section"><text>发病条件</text><view>{{item.conditions}}</view></view>
        <view class="knowledge-section"><text>农业防治</text><view wx:for="{{item.agricultural}}" wx:for-item="advice" wx:key="*this">· {{advice}}</view></view>
        <view class="knowledge-section"><text>药剂防治</text><view wx:for="{{item.chemical}}" wx:for-item="advice" wx:key="*this">· {{advice}}</view></view>
        <view class="knowledge-section"><text>注意事项</text><view>{{item.notes}}</view></view>
      </view>
    </view>

    <view class="grid" style="margin-top:24rpx"><button class="button secondary" bindtap="review">专家复核</button><button class="button" bindtap="treat">记录处置</button></view>
    <view class="muted disclaimer">{{disclaimer}}</view>
  </view>
</view>
