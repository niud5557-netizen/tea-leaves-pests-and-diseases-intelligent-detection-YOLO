<view class="page"><view class="card"><view class="label">巡查地块</view><picker range="{{fields}}" range-key="name" value="{{fieldIndex}}" bindchange="fieldChange"><view class="input">{{fields[fieldIndex].name||'请选择地块'}}</view></picker><button class="button secondary" bindtap="choose">拍照或选择图片</button><image wx:if="{{image}}" class="result-image" src="{{image}}" mode="aspectFit" style="margin-top:20rpx"/><button class="button" loading="{{uploading}}" bindtap="predict" style="margin-top:20rpx">开始识别</button></view><view class="card" wx:if="{{result}}"><view class="name">{{result.diseaseName}}</view><view class="row"><text>模型把握度</text><text>{{result.result.confidence}}</text></view><view class="row"><text>严重程度</text><text>{{result.result.severity}}</text></view><view class="row"><text>病斑/虫口指标</text><text>{{result.result.lesionRatio}}</text></view><view class="row"><text>图像质量</text><text>{{result.result.quality.score}}分</text></view><view class="muted">{{result.advice}}</view><view class="grid" style="margin-top:24rpx"><button class="button secondary" bindtap="review">专家复核</button><button class="button" bindtap="treat">记录处置</button></view><view class="muted" style="margin-top:20rpx">{{result.result.disclaimer}}</view></view></view>