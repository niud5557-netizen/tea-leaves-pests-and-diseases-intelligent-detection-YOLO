
.knowledge-panel{margin-top:28rpx;padding-top:24rpx;border-top:1rpx solid #dcebe1}.knowledge-title{font-size:30rpx;font-weight:800;margin-bottom:16rpx}.knowledge-card{padding:20rpx;border:1rpx solid #dcebe1;border-radius:16rpx;background:#fbfefc}.knowledge-card+.knowledge-card{margin-top:16rpx}.knowledge-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12rpx}.knowledge-name{font-size:28rpx;font-weight:800}.knowledge-section{padding-top:14rpx;margin-top:14rpx;border-top:1rpx solid #edf4ef;color:#6b7c74;font-size:23rpx;line-height:1.7}.knowledge-section text{display:block;color:#167c53;font-weight:700;margin-bottom:4rpx}.disclaimer{padding-top:20rpx;border-top:1rpx solid #dcebe1}
.camera-panel{margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #dcebe1}.camera-view{width:100%;height:480rpx;border-radius:22rpx;background:#17352a}.camera-hint{padding:12rpx 0;color:#6b7c74;font-size:22rpx;line-height:1.5}
.field-error{margin:-8rpx 0 12rpx;color:#b44b3e;font-size:22rpx;line-height:1.5}
