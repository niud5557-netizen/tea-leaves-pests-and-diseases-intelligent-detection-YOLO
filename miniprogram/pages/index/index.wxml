<view class="page"><view class="hero"><view class="title">AI茶查查</view><view class="sub">丘陵茶园病虫害早筛与绿色防控辅助系统</view><view class="grid" style="margin-top:28rpx"><view><view class="title">{{dashboard.records}}</view><view class="sub">识别记录</view></view><view><view class="title">{{dashboard.reviews}}</view><view class="sub">待专家复核</view></view></view></view><view class="card"><view class="grid"><view class="action primary" bindtap="goCapture">📷 拍照识别</view><view class="action" bindtap="goHistory">▤ 历史记录</view><view class="action" bindtap="goTasks">◷ 处置复查</view><view class="action" bindtap="goFields">⌖ 茶园地块</view></view></view><view class="card"><view class="name">最近巡查</view><block wx:if="{{latest.length}}"><view class="record" wx:for="{{latest}}" wx:key="id"><image class="thumb" src="{{item.imageUrl}}" mode="aspectFill"/><view class="grow"><view class="name">{{item.diseaseName}}</view><view class="muted">{{item.field.name}}</view><view class="tag">{{item.status}}</view></view></view></block><view class="empty" wx:else>暂无识别记录</view></view></view>