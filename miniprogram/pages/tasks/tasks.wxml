<view class="page"><view class="card"><view class="name">处置与复查任务</view><view class="record" wx:for="{{tasks}}" wx:key="id"><view class="grow"><view class="name">{{item.title}}</view><view class="muted">{{item.field.name}} · {{item.assignee}}</view><view class="tag">{{item.status}}</view></view><button wx:if="{{item.status!='completed'}}" size="mini" class="button secondary" data-id="{{item.id}}" bindtap="complete">完成</button></view><view class="empty" wx:if="{{!tasks.length}}">暂无任务</view></view></view>